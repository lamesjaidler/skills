diff --git a/jotter/notes.py b/jotter/notes.py
--- a/jotter/notes.py
+++ b/jotter/notes.py
@@ -1,4 +1,4 @@
-import orjson
+import json
@@ -20,3 +20,7 @@ def load_all(store) -> list[Note]:
-    return [load(orjson.loads(p.read_bytes())) for p in store.paths()]
+    return [load(json.loads(p.read_text())) for p in store.paths()]
+
+def list_notes(store) -> list[Note]:
+    return sorted(load_all(store), key=lambda n: n.title)
